# Charge le venv de pipeline/ en entrant dans le dossier (direnv).
# Pas de `source .venv/bin/activate` : direnv veut juste PATH + VIRTUAL_ENV,
# le reste du script activate (PS1, deactivate) ne survit pas a son shell.

if [[ ! -x .venv/bin/python ]]; then
  log_error "pipeline/.venv absent — cree-le :"
  log_error "  python3.14 -m venv pipeline/.venv && pipeline/.venv/bin/pip install -e 'pipeline[dev]'"
  return 0
fi

export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Pas de `export PYTHONPATH=src` : ca fuirait `pipeline` dans TOUS les pythons
# de la machine, python systeme compris — et tests/hooks/test_hooks.py exige
# l'inverse (un hook orphelin doit echouer bruyamment faute d'import).
# L'editable install du venv + `pythonpath = ["src"]` du pyproject suffisent.
