{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh api:*)",
      "Bash(gh run:*)",
      "Bash(gh pr:*)",
      "Bash(scripts/pr-review:*)"
    ],
    "ask": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/scratchpad-notice.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/branch-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/no-secret-paths.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/pr-review-trigger.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.llocal/running_process/PROCESSES.md\"; [ -f \"$f\" ] || exit 0; a=\"\"; for p in $(sed -n 's/^- pid: \\([0-9][0-9]*\\).*/\\1/p' \"$f\"); do kill -0 \"$p\" 2>/dev/null && a=\"$a $p\"; done; [ -n \"$a\" ] && printf '{\"systemMessage\":\"Background processes from this session are still alive (pid:%s). Stop them (see kill: in .llocal/running_process/PROCESSES.md) or delete the stale entry.\"}\\n' \"$a\"; exit 0"
          }
        ]
      }
    ]
  }
}
