# Template for .env.local — committed on purpose, never holds real values.
# Copy it (`cp .env.example .env.local`) and fill in. Every new variable the
# code reads gets a line here, per CLAUDE.md "Repository etiquette".
#
# Only the chat LLM and database sections are consumed by code today. The rest
# are the variables the remaining milestone tasks will need; names follow each
# service's own convention and are settled when that task lands.

# --- Chat LLM (local Qwen via MLX) ------------------------------------------
# Base URL of the OpenAI-compatible endpoint the chat path talks to.
# Local dev points straight at the MLX server; deployed, it's the stable
# Cloudflare Tunnel hostname. Chat inference must stay free — never point
# this at a paid API.
LOCAL_LLM_BASE_URL="http://127.0.0.1:8080/v1"

# --- Database (Supabase Postgres + pgvector) ---------------------------------
# All three come from the Supabase dashboard: Settings -> API Keys. Use the
# opaque sb_publishable_ / sb_secret_ keys, not the legacy anon and
# service_role JWTs (the long ones starting "eyJ") — Supabase retires those at
# the end of 2026.
#
# The publishable key is public by design and ships to the browser, so what
# actually protects data is row-level security, not the key. The secret key
# bypasses RLS: server-side and scripts only. It must never gain a
# NEXT_PUBLIC_ prefix — Next.js inlines every NEXT_PUBLIC_ variable into the
# client bundle at build time, which would publish it to every visitor.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# --- Scraper agent LLM (Mistral API, paid) — not wired up yet ---------------
# Used only by the scraper run from your machine, never by the chat path.
MISTRAL_API_KEY=""

# --- Admin panel — not wired up yet -----------------------------------------
# Single admin, one credential, no roles system.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
